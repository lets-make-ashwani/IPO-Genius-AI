# ============================================================
# IPO Genius AI – Frontend Next.js / TypeScript .gitignore
# ============================================================

# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js Build Output ────────────────────────────────────
.next/
out/
build/
dist/

# ── Environment & Secrets ───────────────────────────────────
# Commit .env.example, never commit actual values.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# ── TypeScript Build Cache ──────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Test Coverage ───────────────────────────────────────────
/coverage
/playwright-report
/test-results
/storybook-static

# ── Cypress ─────────────────────────────────────────────────
cypress/videos/
cypress/screenshots/
cypress/downloads/

# ── Linter / Formatter Cache ────────────────────────────────
.eslintcache
.stylelintcache
.prettiercache

# ── Turbo / Nx ──────────────────────────────────────────────
.turbo/

# ── Debug Logs ──────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# ── Vercel / Netlify Deployment ─────────────────────────────
.vercel
.netlify

# ── IDE / Editor ────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.user

# ── OS Artefacts ────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
ehthumbs.db

# ── Packed / Bundled Archives ───────────────────────────────
*.tgz
*.tar.gz
*.zip
